# qdb-primary-watchdog configuration.
#
# Copy to one of the paths the watchdog auto-loads (first found wins):
#   /etc/qdb-primary-watchdog.env
#   $XDG_CONFIG_HOME/qdb-primary-watchdog.env  (usually ~/.config/qdb-primary-watchdog.env)
#   <same dir as the script>/qdb-primary-watchdog.env
# or point at it explicitly with QDB_WD_CONFIG=/path/to/file.
#
# Precedence: CLI arg (servers) > real environment / systemd EnvironmentFile > this file >
# built-in defaults. Anything already set in the environment is NOT overridden by this file.
#
# Keep this file readable only by its owner (chmod 600): it holds the token.

# ---- REQUIRED (no defaults) ----
QDB_REST_TOKEN=replace-with-your-bearer-token
QDB_WD_SERVERS=172.31.42.41:9003,172.31.41.35:9003,10.0.0.8:9003

# ---- OPTIONAL (defaults shown) ----
#QDB_WD_TARGET_ROLE=primary            # role a node is switched to on failover
#QDB_WD_SWITCH_TIMEOUT_MS=5000         # switch payload timeout_ms, and the promote backoff base
#QDB_WD_STEPDOWN_CONNECT_TIMEOUT=3     # connect timeout (s) for the old-primary step-down; no overall timeout
#QDB_WD_FAIL_THRESHOLD=3               # consecutive non-primary reads before failover
#QDB_WD_CHECK_INTERVAL=1               # seconds between role checks
#QDB_WD_GRACE_PERIOD=5                 # wait (s) after detecting loss before acting, so a manual
                                       # operator switch can settle; re-checked after (0 disables)
#QDB_WD_SWITCH_RETRIES=3               # promote attempts (exponential backoff between them)
#QDB_WD_SWITCH_POLL_INTERVAL=1         # seconds between lifecycle polls after a switch
#QDB_WD_SWITCH_POLL_MAX=30             # max polls to wait for a switch to settle
